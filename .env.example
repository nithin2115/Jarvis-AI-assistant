# JARVIS AI Assistant - Environment Variables
# Copy this file to .env and fill in your keys (optional)

# AI Providers (At least one is recommended for app.py web edition)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Models
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Wake Word (for main.py desktop edition)
PICOVOICE_ACCESS_KEY=

# Google OAuth (for web login in app.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Third-party Integrations (Optional)
NEWSAPI_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
EMAIL_ADDRESS=
EMAIL_PASSWORD=

